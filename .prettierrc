{
    "printWidth": 100,
    "tabWidth": 4,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "semi": true,
    "plugins": ["prettier-plugin-organize-imports"],
    "overrides": [
        {
            "files": ["*.jsx", "*.tsx"],
            "options": {
                "bracketSameLine": false,
                "jsxBracketSameLine": false
            }
        },
        {
            "files": ["*.css"],
            "options": {
                "parser": "css",
                "printWidth": 99999
            }
        },
        {
            "files": ["*.yaml", "*.yml"],
            "options": {
                "parser": "yaml",
                "printWidth": 99999,
                "tabWidth": 2
            }
        }
    ]
}
