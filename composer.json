{
    "name": "jramke/fluid-primitives",
    "type": "typo3-cms-extension",
    "description": "The headless component library for TYPO3 Fluid",
    "license": "GPL-2.0-or-later",
    "version": "1.0.0-beta.6",
    "authors": [
        {
            "name": "Joost Ramke",
            "role": "Developer",
            "email": "hey@joostramke.com",
            "homepage": "https://joostramke.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "typo3/cms-core": "^14",
        "typo3/cms-extbase": "^14",
        "typo3/cms-fluid": "^14",
        "typo3fluid/fluid": "^5.2"
    },
    "require-dev": {
        "carthage-software/mago": "1.48.1",
        "ssch/typo3-rector": "^3.14",
        "typo3/testing-framework": "^9.4"
    },
    "suggest": {
        "jramke/fluid-types": "Generate TypeScript types for component client props and #[TypeScript]-tagged classes."
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "scripts": {
        "test": "php vendor/bin/phpunit -c phpunit.xml --testdox --colors=always --display-notices",
        "test:unit": "@test --testsuite=Unit",
        "test:functional": "@test --testsuite=Functional",
        "format": "mago format Classes Configuration tests",
        "format:check": "mago format Classes Configuration tests --check",
        "rector": "rector process",
        "rector:check": "rector process --dry-run",
        "mago:lint": "mago lint Classes Configuration tests --fix --format-after-fix --unsafe",
        "mago:lint:check": "mago lint Classes Configuration tests",
        "mago:analyze": "mago analyze Classes Configuration tests --fix --format-after-fix --unsafe",
        "mago:analyze:check": "mago analyze Classes Configuration tests",
        "lint": [
            "@rector",
            "@mago:lint",
            "@mago:analyze",
            "@format"
        ],
        "lint:check": [
            "@rector:check",
            "@mago:lint:check",
            "@mago:analyze:check",
            "@format:check"
        ],
        "test:fromdocs": "php ../../vendor/bin/phpunit -c phpunit.xml --testdox --colors=always --display-notices",
        "prepare-release": [
            "rm -rf .github",
            "rm -rf .claude-plugin",
            "rm -rf skills",
            "rm -f .gitignore",
            "rm -f .gitattributes",
            "rm -rf scripts",
            "rm -rf tests",
            "rm -f phpunit.xml",
            "rm -f mago.toml",
            "rm -f .prettierrc",
            "rm -f .prettierignore",
            "rm -f rector.php",
            "rm -f tsconfig.json",
            "rm -f tsdown.config.ts",
            "rm -f vitest.config.ts",
            "rm -f package.json",
            "rm -f package-lock.json"
        ]
    },
    "autoload": {
        "psr-4": {
            "Jramke\\FluidPrimitives\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jramke\\FluidPrimitives\\Tests\\": "tests"
        }
    },
    "replace": {
        "typo3-ter/fluid_primitives": "*"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "fluid_primitives",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
