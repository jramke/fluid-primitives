[
    {
        "name": "numbers as values are strings",
        "wire": {
            "items": [
                {
                    "value": 1,
                    "label": "January"
                },
                {
                    "value": 2,
                    "label": "February"
                }
            ],
            "itemToValueKey": null,
            "itemToStringKey": null,
            "isItemDisabledKey": null,
            "groupByKey": null,
            "groupSort": null
        },
        "expected": {
            "values": ["1", "2"],
            "labels": ["January", "February"],
            "disabled": [false, false],
            "groups": [["", ["1", "2"]]]
        }
    },
    {
        "name": "numbers as labels, and a number as the only key",
        "wire": {
            "items": [
                {
                    "value": 2024,
                    "label": 24
                },
                {
                    "value": 2025
                }
            ],
            "itemToValueKey": null,
            "itemToStringKey": null,
            "isItemDisabledKey": null,
            "groupByKey": null,
            "groupSort": null
        },
        "expected": {
            "values": ["2024", "2025"],
            "labels": ["24", "2025"],
            "disabled": [false, false],
            "groups": [["", ["2024", "2025"]]]
        }
    },
    {
        "name": "the default keys",
        "wire": {
            "items": [
                {
                    "value": "a",
                    "label": "Apple"
                },
                {
                    "value": "b",
                    "label": "Banana",
                    "disabled": true
                },
                {
                    "value": "c"
                }
            ],
            "itemToValueKey": null,
            "itemToStringKey": null,
            "isItemDisabledKey": null,
            "groupByKey": null,
            "groupSort": null
        },
        "expected": {
            "values": ["a", "b", "c"],
            "labels": ["Apple", "Banana", "c"],
            "disabled": [false, true, false],
            "groups": [["", ["a", "b", "c"]]]
        }
    },
    {
        "name": "the keys of the items",
        "wire": {
            "items": [
                {
                    "id": "usr-1",
                    "name": "John",
                    "isInactive": true,
                    "team": "red"
                },
                {
                    "id": "usr-2",
                    "name": "Jane",
                    "isInactive": false,
                    "team": "blue"
                },
                {
                    "id": "usr-3",
                    "name": "Jim",
                    "isInactive": false,
                    "team": "red"
                }
            ],
            "itemToValueKey": "id",
            "itemToStringKey": "name",
            "isItemDisabledKey": "isInactive",
            "groupByKey": "team",
            "groupSort": null
        },
        "expected": {
            "values": ["usr-1", "usr-2", "usr-3"],
            "labels": ["John", "Jane", "Jim"],
            "disabled": [true, false, false],
            "groups": [
                ["red", ["usr-1", "usr-3"]],
                ["blue", ["usr-2"]]
            ]
        }
    },
    {
        "name": "keys with dots into nested items, groups in the order of a list",
        "wire": {
            "items": [
                {
                    "meta": {
                        "id": "n-1",
                        "region": "south"
                    },
                    "display": {
                        "title": "Nested One"
                    },
                    "state": {
                        "locked": false
                    }
                },
                {
                    "meta": {
                        "id": "n-2",
                        "region": "north"
                    },
                    "display": {
                        "title": "Nested Two"
                    },
                    "state": {
                        "locked": true
                    }
                },
                {
                    "meta": {
                        "id": "n-3",
                        "region": "south"
                    },
                    "display": {
                        "title": "Nested Three"
                    },
                    "state": {
                        "locked": false
                    }
                }
            ],
            "itemToValueKey": "meta.id",
            "itemToStringKey": "display.title",
            "isItemDisabledKey": "state.locked",
            "groupByKey": "meta.region",
            "groupSort": ["north", "south"]
        },
        "expected": {
            "values": ["n-1", "n-2", "n-3"],
            "labels": ["Nested One", "Nested Two", "Nested Three"],
            "disabled": [false, true, false],
            "groups": [
                ["north", ["n-2"]],
                ["south", ["n-1", "n-3"]]
            ]
        }
    },
    {
        "name": "groups sorted ascending",
        "wire": {
            "items": [
                {
                    "value": "c",
                    "label": "C",
                    "cat": "Zebra"
                },
                {
                    "value": "a",
                    "label": "A",
                    "cat": "Apple"
                },
                {
                    "value": "b",
                    "label": "B",
                    "cat": "Mango"
                }
            ],
            "itemToValueKey": null,
            "itemToStringKey": null,
            "isItemDisabledKey": null,
            "groupByKey": "cat",
            "groupSort": "asc"
        },
        "expected": {
            "values": ["c", "a", "b"],
            "labels": ["C", "A", "B"],
            "disabled": [false, false, false],
            "groups": [
                ["Apple", ["a"]],
                ["Mango", ["b"]],
                ["Zebra", ["c"]]
            ]
        }
    },
    {
        "name": "groups sorted descending",
        "wire": {
            "items": [
                {
                    "value": "c",
                    "label": "C",
                    "cat": "Zebra"
                },
                {
                    "value": "a",
                    "label": "A",
                    "cat": "Apple"
                },
                {
                    "value": "b",
                    "label": "B",
                    "cat": "Mango"
                }
            ],
            "itemToValueKey": null,
            "itemToStringKey": null,
            "isItemDisabledKey": null,
            "groupByKey": "cat",
            "groupSort": "desc"
        },
        "expected": {
            "values": ["c", "a", "b"],
            "labels": ["C", "A", "B"],
            "disabled": [false, false, false],
            "groups": [
                ["Zebra", ["c"]],
                ["Mango", ["b"]],
                ["Apple", ["a"]]
            ]
        }
    },
    {
        "name": "groups the list does not name come last",
        "wire": {
            "items": [
                {
                    "value": "e",
                    "label": "E",
                    "region": "east"
                },
                {
                    "value": "n",
                    "label": "N",
                    "region": "north"
                },
                {
                    "value": "s",
                    "label": "S",
                    "region": "south"
                }
            ],
            "itemToValueKey": null,
            "itemToStringKey": null,
            "isItemDisabledKey": null,
            "groupByKey": "region",
            "groupSort": ["south", "north"]
        },
        "expected": {
            "values": ["e", "n", "s"],
            "labels": ["E", "N", "S"],
            "disabled": [false, false, false],
            "groups": [
                ["south", ["s"]],
                ["north", ["n"]],
                ["east", ["e"]]
            ]
        }
    }
]
